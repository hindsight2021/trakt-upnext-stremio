TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here
SESSION_SECRET=any_random_long_string_here
# Set this to your Pi's address so Trakt OAuth redirects back correctly.
# Example: http://192.168.1.100:7000/api/trakt/callback
# Or if you have a local hostname: http://raspberrypi.local:7000/api/trakt/callback
TRAKT_REDIRECT_URI=http://YOUR_PI_IP:7000/api/trakt/callback
